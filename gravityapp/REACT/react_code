import { motion } from 'motion/react';
import { Camera, TrendingUp, Users, Settings, Droplet, Moon, Footprints, RefreshCw, AlertCircle, Scale, Plus, X, Bell, UtensilsCrossed, FileText, Calendar, BarChart3 } from 'lucide-react';
import { ProgressRing } from '../ProgressRing';
import { Screen, UserType } from '../../App';
import { useEffect, useState } from 'react';
import { healthSyncService, HealthMetrics } from '../../services/healthSync';
import { Dialog, DialogContent, DialogHeader, DialogTitle, DialogDescription } from '../ui/dialog';
import { Input } from '../ui/input';
import { Button } from '../ui/button';
import { BottomNav } from '../BottomNav';

interface DashboardScreenProps {
  onNavigate: (screen: Screen) => void;
  userType?: UserType;
}

export function DashboardScreen({ onNavigate, userType }: DashboardScreenProps) {
  const [healthMetrics, setHealthMetrics] = useState<HealthMetrics>(healthSyncService.getMetrics());
  const [isSyncing, setIsSyncing] = useState(false);
  const [waterIntake, setWaterIntake] = useState(1.2); // Water tracking is manual
  const [weight, setWeight] = useState(82.4); // Current weight in kg
  const [previousWeight] = useState(82.8); // Previous weight for trend calculation
  const weightGoal = 75; // Target weight in kg
  
  // Fasting states
  const [fastingMode, setFastingMode] = useState<'normal' | 'omad'>('normal'); // normal = 2 meals, omad = 1 meal
  const [mealsEaten, setMealsEaten] = useState(1); // Number of meals eaten today
  
  // Modal states
  const [showWeightModal, setShowWeightModal] = useState(false);
  const [showStepsModal, setShowStepsModal] = useState(false);
  const [showSleepModal, setShowSleepModal] = useState(false);
  const [showHydrationModal, setShowHydrationModal] = useState(false);
  const [showFastingModal, setShowFastingModal] = useState(false);
  
  // Input states
  const [weightInput, setWeightInput] = useState('');
  const [stepsInput, setStepsInput] = useState('');
  const [sleepInput, setSleepInput] = useState('');
  const [hydrationInput, setHydrationInput] = useState('');
  
  // Calculate weight trend
  const weightChange = previousWeight - weight;
  const weightTrend = weightChange > 0.1 ? 'down' : weightChange < -0.1 ? 'up' : 'flat';

  // Manual entry handlers
  const handleWeightSubmit = () => {
    const value = parseFloat(weightInput);
    if (!isNaN(value) && value > 0 && value < 300) {
      setWeight(value);
      setWeightInput('');
      setShowWeightModal(false);
    }
  };

  const handleStepsSubmit = () => {
    const value = parseInt(stepsInput);
    if (!isNaN(value) && value >= 0 && value < 100000) {
      setHealthMetrics({ ...healthMetrics, steps: value });
      setStepsInput('');
      setShowStepsModal(false);
    }
  };

  const handleSleepSubmit = () => {
    const value = parseFloat(sleepInput);
    if (!isNaN(value) && value >= 0 && value <= 24) {
      setHealthMetrics({ ...healthMetrics, sleepHours: value });
      setSleepInput('');
      setShowSleepModal(false);
    }
  };

  const handleHydrationSubmit = () => {
    const value = parseFloat(hydrationInput);
    if (!isNaN(value) && value >= 0 && value <= 10) {
      setWaterIntake(value);
      setHydrationInput('');
      setShowHydrationModal(false);
    }
  };

  useEffect(() => {
    // Subscribe to health metrics updates
    const unsubscribe = healthSyncService.subscribe((metrics) => {
      setHealthMetrics(metrics);
      setIsSyncing(metrics.syncStatus === 'syncing');
    });

    return () => unsubscribe();
  }, []);

  const handleManualSync = async () => {
    setIsSyncing(true);
    try {
      await healthSyncService.syncHealthData();
    } catch (error) {
      console.error('Manual sync failed:', error);
    }
  };

  // Calculate overall progress (average of all four metrics)
  const stepsProgress = (healthMetrics.steps / 10000) * 100;
  const sleepProgress = (healthMetrics.sleepHours / 8) * 100;
  const waterProgress = (waterIntake / 2.5) * 100;
  const weightProgress = Math.max(0, 100 - ((weight - weightGoal) / weightGoal * 100)); // Progress toward goal
  const overallProgress = Math.round((stepsProgress + sleepProgress + waterProgress + weightProgress) / 4);

  const formatLastSync = () => {
    if (!healthMetrics.lastSyncTime) return 'Never';
    const now = new Date();
    const diff = now.getTime() - healthMetrics.lastSyncTime.getTime();
    const minutes = Math.floor(diff / 60000);
    if (minutes < 1) return 'Just now';
    if (minutes < 60) return `${minutes}m ago`;
    const hours = Math.floor(minutes / 60);
    return `${hours}h ago`;
  };

  const getSyncStatusColor = () => {
    switch (healthMetrics.syncStatus) {
      case 'success': return 'text-[#00B8A9]';
      case 'error': return 'text-red-500';
      case 'syncing': return 'text-blue-500';
      default: return 'text-gray-400';
    }
  };

  return (
    <div className="h-full flex flex-col bg-gradient-to-br from-[#F5F6FA] to-white overflow-y-auto">
      {/* Header */}
      <div className="bg-gradient-to-br from-[#0A2342] to-[#00B8A9] px-4 sm:px-6 md:px-8 pt-12 sm:pt-14 pb-6 sm:pb-8 rounded-b-[40px]">
        <div className="flex items-center justify-between mb-2 sm:mb-4 max-w-7xl mx-auto">
          <div>
            <p className="text-white/80">Welcome back,</p>
            <h2 className="text-white">Sarah</h2>
          </div>
          <div className="flex items-center gap-2 sm:gap-3">
            <motion.button
              onClick={() => onNavigate('notifications')}
              className="w-10 h-10 sm:w-12 sm:h-12 bg-white/20 backdrop-blur-sm rounded-2xl flex items-center justify-center relative"
              whileTap={{ scale: 0.9 }}
            >
              <Bell className="w-5 h-5 sm:w-6 sm:h-6 text-white" />
              {/* Notification Badge */}
              <div className="absolute -top-1 -right-1 w-5 h-5 bg-red-500 rounded-full flex items-center justify-center">
                <span className="text-white text-xs">3</span>
              </div>
            </motion.button>
            <motion.button
              onClick={() => onNavigate('settings')}
              className="w-10 h-10 sm:w-12 sm:h-12 bg-white/20 backdrop-blur-sm rounded-2xl flex items-center justify-center"
              whileTap={{ scale: 0.9 }}
            >
              <Settings className="w-5 h-5 sm:w-6 sm:h-6 text-white" />
            </motion.button>
          </div>
        </div>

        <p className="text-[#D4AF37] max-w-7xl mx-auto mb-3">Thursday, November 13, 2025</p>
      </div>

      {/* Health Sync Status */}
      {healthMetrics.syncStatus !== 'never' && (
        <div className="px-4 sm:px-6 md:px-8 -mt-6 mb-2">
          <motion.div
            className="bg-white/80 backdrop-blur-sm rounded-2xl px-4 py-2 flex items-center justify-between max-w-7xl mx-auto shadow-sm"
            initial={{ opacity: 0, y: -10 }}
            animate={{ opacity: 1, y: 0 }}
          >
            <div className="flex items-center gap-2">
              {healthMetrics.syncStatus === 'syncing' ? (
                <RefreshCw className="w-4 h-4 text-blue-500 animate-spin" />
              ) : healthMetrics.syncStatus === 'error' ? (
                <AlertCircle className="w-4 h-4 text-red-500" />
              ) : (
                <div className="w-2 h-2 bg-[#00B8A9] rounded-full" />
              )}
              <span className={`text-sm ${getSyncStatusColor()}`}>
                {healthMetrics.syncStatus === 'syncing' && 'Syncing health data...'}
                {healthMetrics.syncStatus === 'success' && `Synced ${formatLastSync()}`}
                {healthMetrics.syncStatus === 'error' && 'Sync failed'}
              </span>
              {healthMetrics.platform !== 'none' && (
                <span className="text-xs text-[#0A2342]/40">
                  · {healthMetrics.platform === 'apple' ? 'Apple Health' : 'Google Fit'}
                </span>
              )}
            </div>
            {!isSyncing && (
              <motion.button
                onClick={handleManualSync}
                className="text-[#00B8A9] text-sm hover:underline"
                whileTap={{ scale: 0.95 }}
              >
                Refresh
              </motion.button>
            )}
          </motion.div>
        </div>
      )}

      {/* Progress Rings */}
      <div className="px-4 sm:px-6 md:px-8 mt-1 mb-4 sm:mb-6">
        <motion.div
          className="bg-white rounded-[28px] shadow-sm p-5 sm:p-7 max-w-7xl mx-auto"
          initial={{ opacity: 0, y: 20 }}
          animate={{ opacity: 1, y: 0 }}
        >
          <h3 className="text-[#0A2342] mb-5 sm:mb-6" style={{ fontSize: 'var(--text-lg)', fontWeight: 'var(--font-weight-medium)' }}>Today's Progress</h3>
          <div className="grid grid-cols-4 gap-3 sm:gap-4">
            <ProgressRing
              value={weight}
              max={weightGoal}
              label="Weight"
              icon={<Scale className="w-4 h-4" />}
              color="#D4AF37"
              suffix="kg"
              trend={weightTrend}
              trendValue={weightChange}
            />
            <ProgressRing
              value={healthMetrics.steps}
              max={10000}
              label="Steps"
              icon={<Footprints className="w-4 h-4" />}
              color="#00B8A9"
            />
            <ProgressRing
              value={healthMetrics.sleepHours}
              max={8}
              label="Sleep"
              icon={<Moon className="w-4 h-4" />}
              color="#0A2342"
              suffix="hrs"
            />
            <ProgressRing
              value={mealsEaten}
              max={fastingMode === 'omad' ? 1 : 2}
              label="Fasting"
              icon={<UtensilsCrossed className="w-4 h-4" />}
              color="#D4AF37"
              customValue={`${mealsEaten}/${fastingMode === 'omad' ? 1 : 2}`}
            />
          </div>
        </motion.div>
      </div>

      {/* Weight Loss Journey */}
      <div className="px-4 sm:px-6 md:px-8 mb-4 sm:mb-6">
        <WeightLossTracker
          startingWeight={85}
          currentWeight={weight}
          goalWeight={weightGoal}
        />
      </div>

      {/* Summary & Reports Navigation */}
      <div className="px-4 sm:px-6 md:px-8 mb-4 sm:mb-6">
        <SummaryReportsNav onNavigate={onNavigate} />
      </div>

      {/* Quick Actions */}
      <div className="px-4 sm:px-6 md:px-8 mb-4">
        <div className="max-w-7xl mx-auto">
          <h3 className="text-[#0A2342] mb-4">Quick Actions</h3>
          <div className="grid grid-cols-2 gap-3 sm:gap-4">
            <QuickActionCard
              icon={<Camera className="w-5 h-5 sm:w-6 sm:h-6" />}
              title="Upload Meal"
              gradient="from-[#F9A71F] to-[#F57C00]"
              onClick={() => onNavigate('meal-upload')}
            />
            <QuickActionCard
              icon={<Scale className="w-5 h-5 sm:w-6 sm:h-6" />}
              title="Add Weight"
              gradient="from-[#00B8A9] to-[#0A2342]"
              onClick={() => setShowWeightModal(true)}
            />
            <QuickActionCard
              icon={<Moon className="w-5 h-5 sm:w-6 sm:h-6" />}
              title="Log Sleep"
              gradient="from-[#6C63FF] to-[#7F82FF]"
              onClick={() => setShowSleepModal(true)}
            />
            <QuickActionCard
              icon={<Droplet className="w-5 h-5 sm:w-6 sm:h-6" />}
              title="Log Hydration"
              gradient="from-[#00B8A9] to-[#00E5D3]"
              onClick={() => setShowHydrationModal(true)}
            />
            <QuickActionCard
              icon={<Footprints className="w-5 h-5 sm:w-6 sm:h-6" />}
              title="Log Steps"
              gradient="from-[#00B8A9] to-[#00D4C3]"
              onClick={() => setShowStepsModal(true)}
            />
            <QuickActionCard
              icon={<UtensilsCrossed className="w-5 h-5 sm:w-6 sm:h-6" />}
              title="Fasting Mode"
              gradient="from-[#D4AF37] to-[#B8941F]"
              onClick={() => setShowFastingModal(true)}
            />
          </div>
        </div>
      </div>

      {/* Manual Entry Modals */}
      <ManualEntryModal
        open={showWeightModal}
        onOpenChange={setShowWeightModal}
        title="Add Weight"
        icon={<Scale className="w-6 h-6 text-[#00B8A9]" />}
        value={weightInput}
        onChange={setWeightInput}
        onSubmit={handleWeightSubmit}
        placeholder="Enter weight in kg"
        unit="kg"
        gradient="from-[#00B8A9] to-[#0A2342]"
      />
      
      <ManualEntryModal
        open={showStepsModal}
        onOpenChange={setShowStepsModal}
        title="Log Steps"
        icon={<Footprints className="w-6 h-6 text-[#00B8A9]" />}
        value={stepsInput}
        onChange={setStepsInput}
        onSubmit={handleStepsSubmit}
        placeholder="Enter steps count"
        unit="steps"
        gradient="from-[#00B8A9] to-[#00D4C3]"
      />
      
      <ManualEntryModal
        open={showSleepModal}
        onOpenChange={setShowSleepModal}
        title="Log Sleep"
        icon={<Moon className="w-6 h-6 text-[#6C63FF]" />}
        value={sleepInput}
        onChange={setSleepInput}
        onSubmit={handleSleepSubmit}
        placeholder="Enter hours slept"
        unit="hours"
        gradient="from-[#6C63FF] to-[#7F82FF]"
      />
      
      <ManualEntryModal
        open={showHydrationModal}
        onOpenChange={setShowHydrationModal}
        title="Log Hydration"
        icon={<Droplet className="w-6 h-6 text-[#00B8A9]" />}
        value={hydrationInput}
        onChange={setHydrationInput}
        onSubmit={handleHydrationSubmit}
        placeholder="Enter water intake in liters"
        unit="liters"
        gradient="from-[#00B8A9] to-[#00E5D3]"
      />

      {/* Fasting Mode Modal */}
      <FastingModeModal
        open={showFastingModal}
        onOpenChange={setShowFastingModal}
        currentMode={fastingMode}
        onModeChange={(mode) => {
          setFastingMode(mode);
          // Reset meals if changing to OMAD and already eaten 2
          if (mode === 'omad' && mealsEaten > 1) {
            setMealsEaten(1);
          }
          setShowFastingModal(false);
        }}
        mealsEaten={mealsEaten}
        onMealsChange={setMealsEaten}
        maxMeals={fastingMode === 'omad' ? 1 : 2}
      />

      {/* Community Preview */}
      <div className="px-4 sm:px-6 md:px-8 pb-24">
        <motion.button
          onClick={() => onNavigate('community')}
          className="w-full max-w-7xl mx-auto bg-white rounded-[24px] shadow-sm p-4 sm:p-6 flex items-center justify-between"
          whileTap={{ scale: 0.98 }}
        >
          <div className="flex items-center gap-3 sm:gap-4">
            <div className="w-10 h-10 sm:w-12 sm:h-12 bg-gradient-to-br from-rose-400 to-rose-600 rounded-2xl flex items-center justify-center flex-shrink-0">
              <Users className="w-5 h-5 sm:w-6 sm:h-6 text-white" />
            </div>
            <div className="text-left">
              <h4 className="text-[#0A2342]">Community Feed</h4>
              <p className="text-[#0A2342]/60 text-sm">Share your journey</p>
            </div>
          </div>
          <div className="text-[#00B8A9]">→</div>
        </motion.button>
      </div>

      {/* Bottom Navigation */}
      <BottomNav currentScreen="dashboard" onNavigate={onNavigate} userType={userType} />
    </div>
  );
}

interface QuickActionCardProps {
  icon: React.ReactNode;
  title: string;
  gradient: string;
  onClick: () => void;
}

function QuickActionCard({ icon, title, gradient, onClick }: QuickActionCardProps) {
  return (
    <motion.button
      onClick={onClick}
      className={`bg-gradient-to-br ${gradient} rounded-[20px] px-4 py-3 text-white shadow-sm flex items-center gap-3`}
      whileTap={{ scale: 0.95 }}
    >
      <div className="w-5 h-5">
        {icon}
      </div>
      <span className="text-sm">{title}</span>
    </motion.button>
  );
}

interface ManualEntryModalProps {
  open: boolean;
  onOpenChange: (open: boolean) => void;
  title: string;
  icon: React.ReactNode;
  value: string;
  onChange: (value: string) => void;
  onSubmit: () => void;
  placeholder: string;
  unit: string;
  gradient: string;
}

function ManualEntryModal({ open, onOpenChange, title, icon, value, onChange, onSubmit, placeholder, unit, gradient }: ManualEntryModalProps) {
  return (
    <Dialog open={open} onOpenChange={onOpenChange}>
      <DialogContent 
        className="bg-white rounded-[20px] shadow-sm p-5 sm:p-7 max-w-7xl mx-auto"
        onClose={() => onOpenChange(false)}
      >
        <DialogHeader>
          <DialogTitle className="text-[#0A2342] mb-4">{title}</DialogTitle>
          <div className="flex items-center gap-2">
            {icon}
            <p className="text-[#0A2342]/70 text-sm">Enter your {unit}</p>
          </div>
          <DialogDescription className="text-[#0A2342]/60 text-sm">
            This will be recorded in your health metrics.
          </DialogDescription>
        </DialogHeader>
        <Input
          type="number"
          min="0"
          value={value}
          onChange={(e) => onChange(e.target.value)}
          placeholder={placeholder}
          className="bg-[#F5F6FA] rounded-[10px] px-4 py-3 text-[#0A2342] shadow-sm"
        />
        <div className="flex justify-end mt-4">
          <Button
            onClick={onSubmit}
            className={`bg-gradient-to-br ${gradient} rounded-[10px] px-4 py-3 text-white shadow-sm`}
          >
            Submit
          </Button>
        </div>
      </DialogContent>
    </Dialog>
  );
}

interface FastingModeModalProps {
  open: boolean;
  onOpenChange: (open: boolean) => void;
  currentMode: 'normal' | 'omad';
  onModeChange: (mode: 'normal' | 'omad') => void;
  mealsEaten: number;
  onMealsChange: (meals: number) => void;
  maxMeals: number;
}

function FastingModeModal({ open, onOpenChange, currentMode, onModeChange, mealsEaten, onMealsChange, maxMeals }: FastingModeModalProps) {
  return (
    <Dialog open={open} onOpenChange={onOpenChange}>
      <DialogContent 
        className="bg-white rounded-[20px] shadow-sm p-5 sm:p-7 max-w-7xl mx-auto"
        onClose={() => onOpenChange(false)}
      >
        <DialogHeader>
          <DialogTitle className="text-[#0A2342] mb-2">Fasting Tracker</DialogTitle>
          <DialogDescription className="text-[#0A2342]/60 text-sm mb-4">
            Manage your daily meal plan
          </DialogDescription>
        </DialogHeader>
        
        {/* Mode Selection */}
        <div>
          <p className="text-[#0A2342]/70 text-sm mb-3">Fasting Mode:</p>
          <div className="grid grid-cols-2 gap-4">
            <motion.button
              onClick={() => {
                onModeChange('normal');
                if (mealsEaten > 2) onMealsChange(2);
              }}
              className={`${
                currentMode === 'normal' 
                  ? 'bg-gradient-to-br from-[#D4AF37] to-[#B8941F] text-white' 
                  : 'bg-[#F5F6FA] text-[#0A2342]'
              } rounded-[16px] p-4 shadow-sm flex flex-col items-center justify-center gap-2`}
              whileTap={{ scale: 0.95 }}
            >
              <UtensilsCrossed className="w-6 h-6" />
              <div className="text-center">
                <p className="font-semibold">Normal</p>
                <p className="text-xs opacity-80">2 Meals/Day</p>
              </div>
            </motion.button>
            <motion.button
              onClick={() => {
                onModeChange('omad');
                if (mealsEaten > 1) onMealsChange(1);
              }}
              className={`${
                currentMode === 'omad' 
                  ? 'bg-gradient-to-br from-[#D4AF37] to-[#B8941F] text-white' 
                  : 'bg-[#F5F6FA] text-[#0A2342]'
              } rounded-[16px] p-4 shadow-sm flex flex-col items-center justify-center gap-2`}
              whileTap={{ scale: 0.95 }}
            >
              <UtensilsCrossed className="w-6 h-6" />
              <div className="text-center">
                <p className="font-semibold">O.M.A.D</p>
                <p className="text-xs opacity-80">1 Meal/Day</p>
              </div>
            </motion.button>
          </div>
        </div>

        {/* Meal Tracking */}
        <div className="mt-6 pt-6 border-t border-[#0A2342]/10">
          <p className="text-[#0A2342]/70 text-sm mb-3">Log Your Meals:</p>
          <div className="grid grid-cols-2 gap-3">
            <motion.button
              onClick={() => onMealsChange(mealsEaten === 1 ? 0 : 1)}
              className={`${
                mealsEaten >= 1
                  ? 'bg-gradient-to-br from-[#00B8A9] to-[#0A2342] text-white'
                  : 'bg-[#F5F6FA] text-[#0A2342]/40'
              } rounded-[14px] p-4 shadow-sm flex flex-col items-center justify-center gap-2`}
              whileTap={{ scale: 0.95 }}
            >
              <UtensilsCrossed className="w-5 h-5" />
              <p className="text-sm font-semibold">Meal 1</p>
              {mealsEaten >= 1 && <p className="text-xs opacity-80">✓ Logged</p>}
            </motion.button>
            
            {currentMode === 'normal' && (
              <motion.button
                onClick={() => onMealsChange(mealsEaten === 2 ? 1 : 2)}
                className={`${
                  mealsEaten >= 2
                    ? 'bg-gradient-to-br from-[#00B8A9] to-[#0A2342] text-white'
                    : 'bg-[#F5F6FA] text-[#0A2342]/40'
                } rounded-[14px] p-4 shadow-sm flex flex-col items-center justify-center gap-2`}
                whileTap={{ scale: 0.95 }}
              >
                <UtensilsCrossed className="w-5 h-5" />
                <p className="text-sm font-semibold">Meal 2</p>
                {mealsEaten >= 2 && <p className="text-xs opacity-80">✓ Logged</p>}
              </motion.button>
            )}
          </div>
          
          {/* Reset Button */}
          <motion.button
            onClick={() => onMealsChange(0)}
            className="w-full mt-3 bg-[#F5F6FA] text-[#0A2342]/60 rounded-[12px] px-4 py-2 text-sm hover:bg-[#0A2342]/5"
            whileTap={{ scale: 0.95 }}
          >
            Reset All
          </motion.button>
        </div>
      </DialogContent>
    </Dialog>
  );
}

interface WeightLossTrackerProps {
  startingWeight: number;
  currentWeight: number;
  goalWeight: number;
}

function WeightLossTracker({ startingWeight, currentWeight, goalWeight }: WeightLossTrackerProps) {
  const totalWeightLoss = startingWeight - goalWeight;
  const currentWeightLoss = startingWeight - currentWeight;
  const remainingWeight = currentWeight - goalWeight;
  const progressPercentage = Math.min(100, Math.max(0, (currentWeightLoss / totalWeightLoss) * 100));

  return (
    <motion.div
      className="bg-white rounded-[28px] shadow-sm p-5 sm:p-7 max-w-7xl mx-auto"
      initial={{ opacity: 0, y: 20 }}
      animate={{ opacity: 1, y: 0 }}
      transition={{ delay: 0.2 }}
    >
      <h3 className="text-[#0A2342] mb-6" style={{ fontSize: 'var(--text-lg)', fontWeight: 'var(--font-weight-medium)' }}>Weight Loss Journey</h3>
      
      {/* Top Labels - Starting and Current Weight */}
      <div className="flex justify-between items-start mb-3">
        <div>
          <p className="text-[#0A2342]/50 text-xs mb-1">Starting Weight</p>
          <p className="text-[#0A2342] font-semibold">{startingWeight} kg</p>
        </div>
        <div className="text-right">
          <p className="text-[#0A2342]/50 text-xs mb-1">Current Weight</p>
          <p className="text-[#00B8A9] font-bold text-lg">{currentWeight} kg</p>
        </div>
      </div>

      {/* Progress Bar Container */}
      <div className="relative py-8">
        {/* Labels Above Bar */}
        <div className="absolute -top-1 left-0 right-0 flex justify-between text-xs text-[#0A2342]/40">
          <span>0 kg</span>
          <span>Goal: {totalWeightLoss.toFixed(1)} kg</span>
        </div>

        {/* Progress Bar Track */}
        <div className="relative h-2 bg-[#E5E7EB] rounded-full overflow-hidden">
          {/* Active Progress with Gradient */}
          <motion.div
            className="absolute left-0 top-0 h-full bg-gradient-to-r from-[#00B8A9] to-[#0A2342] rounded-full"
            initial={{ width: 0 }}
            animate={{ width: `${progressPercentage}%` }}
            transition={{ duration: 1, ease: 'easeOut' }}
          />
        </div>

        {/* Progress Marker (Thumb) */}
        <motion.div
          className="absolute top-1/2 -translate-y-1/2"
          style={{ left: `${progressPercentage}%` }}
          initial={{ scale: 0 }}
          animate={{ scale: 1 }}
          transition={{ delay: 0.5, type: 'spring', stiffness: 200 }}
        >
          {/* Marker Circle */}
          <div className="relative -translate-x-1/2">
            <div className="w-6 h-6 bg-[#D4AF37] rounded-full shadow-lg border-4 border-white" />
            {/* Text Below Marker */}
            <div className="absolute top-8 left-1/2 -translate-x-1/2 whitespace-nowrap">
              <p className="text-[#D4AF37] font-bold text-sm">{currentWeightLoss.toFixed(1)} kg lost</p>
            </div>
          </div>
        </motion.div>
      </div>

      {/* Bottom Summary */}
      <div className="mt-6 pt-4 border-t border-[#0A2342]/10 flex items-center justify-between">
        <div className="flex items-center gap-2">
          <div className="w-2 h-2 bg-[#00B8A9] rounded-full" />
          <p className="text-[#0A2342]/70 text-sm">
            Weight Lost: <span className="text-[#0A2342] font-semibold">{currentWeightLoss.toFixed(1)} kg</span>
          </p>
        </div>
        <div className="flex items-center gap-2">
          <div className="w-2 h-2 bg-[#E5E7EB] rounded-full" />
          <p className="text-[#0A2342]/70 text-sm">
            Remaining: <span className="text-[#0A2342] font-semibold">{remainingWeight.toFixed(1)} kg</span>
          </p>
        </div>
      </div>
    </motion.div>
  );
}

interface SummaryReportsNavProps {
  onNavigate: (screen: Screen) => void;
}

function SummaryReportsNav({ onNavigate }: SummaryReportsNavProps) {
  // Get current date for week range
  const getCurrentWeekRange = () => {
    const now = new Date();
    const dayOfWeek = now.getDay();
    const startDate = new Date(now);
    startDate.setDate(now.getDate() - dayOfWeek);
    const endDate = new Date(startDate);
    endDate.setDate(startDate.getDate() + 6);
    
    const formatDate = (date: Date) => {
      return date.toLocaleDateString('en-US', { month: 'short', day: 'numeric' });
    };
    
    return `${formatDate(startDate)} - ${formatDate(endDate)}`;
  };

  return (
    <motion.div
      className="bg-white rounded-[28px] shadow-sm p-5 sm:p-7 max-w-7xl mx-auto"
      initial={{ opacity: 0, y: 20 }}
      animate={{ opacity: 1, y: 0 }}
      transition={{ delay: 0.3 }}
    >
      <div className="mb-4">
        <h3 className="text-[#0A2342]" style={{ fontSize: 'var(--text-lg)', fontWeight: 'var(--font-weight-medium)' }}>Gravity</h3>
        <p className="text-[#0A2342]/60 text-sm">Your wellness companion</p>
      </div>

      <div className="space-y-3">
        {/* Today Card */}
        <motion.button
          onClick={() => onNavigate('daily-summary')}
          className="w-full bg-[#E6F7F5] rounded-[16px] p-4 border-2 border-[#00B8A9]/30 flex items-center gap-4"
          whileTap={{ scale: 0.98 }}
        >
          <div className="w-10 h-10 bg-white rounded-full flex items-center justify-center flex-shrink-0 shadow-sm">
            <FileText className="w-5 h-5 text-[#00B8A9]" />
          </div>
          <div className="flex-1 text-left">
            <p className="text-[#0A2342] font-semibold">Today</p>
            <p className="text-[#0A2342]/60 text-sm">End-of-day summary</p>
          </div>
          <div className="text-[#00B8A9]">→</div>
        </motion.button>

        {/* Weekly Review Card */}
        <motion.button
          onClick={() => onNavigate('weekly-review')}
          className="w-full bg-[#FFF9E6] rounded-[16px] p-4 border-2 border-[#D4AF37]/30 flex items-center gap-4"
          whileTap={{ scale: 0.98 }}
        >
          <div className="w-10 h-10 bg-white rounded-full flex items-center justify-center flex-shrink-0 shadow-sm">
            <Calendar className="w-5 h-5 text-[#D4AF37]" />
          </div>
          <div className="flex-1 text-left">
            <p className="text-[#0A2342] font-semibold">Weekly Review</p>
            <p className="text-[#0A2342]/60 text-sm">{getCurrentWeekRange()}</p>
          </div>
          <div className="text-[#D4AF37]">→</div>
        </motion.button>

        {/* Daily Details Card */}
        <motion.button
          onClick={() => onNavigate('daily-details')}
          className="w-full bg-[#E6F7F5] rounded-[16px] p-4 border-2 border-[#00B8A9]/30 flex items-center gap-4"
          whileTap={{ scale: 0.98 }}
        >
          <div className="w-10 h-10 bg-white rounded-full flex items-center justify-center flex-shrink-0 shadow-sm">
            <BarChart3 className="w-5 h-5 text-[#00B8A9]" />
          </div>
          <div className="flex-1 text-left">
            <p className="text-[#0A2342] font-semibold">Daily Details</p>
            <p className="text-[#0A2342]/60 text-sm">Day-by-day breakdown</p>
          </div>
          <div className="text-[#00B8A9]">→</div>
        </motion.button>
      </div>
    </motion.div>
  );
}