rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // users/{uid}: only that user can read/write their own doc
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
    // conversations/{conversationId}: only members can read/write
    match /conversations/{conversationId} {
      allow read, update, delete: if request.auth != null
        && request.auth.uid in resource.data.members;
      allow create: if request.auth != null
        && request.auth.uid in request.resource.data.members;
    }
    // conversations/{conversationId}/messages/{messageId}: same as parent
    match /conversations/{conversationId}/messages/{messageId} {
      allow read, write: if request.auth != null
        && request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.members;
    }
    // conversations/{conversationId}/readStatus/{uid}: members only
    match /conversations/{conversationId}/readStatus/{uid} {
      allow read, write: if request.auth != null
        && request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.members;
    }
  }
}
